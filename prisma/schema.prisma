// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model - foundation for multi-tenant system
model User {
  id       String   @id @default(uuid())
  email    String   @unique
  name     String?
  password String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goals         Goal[]
  habits        Habit[]
  refreshTokens RefreshToken[]

  @@index([email])
}

// Goal - a calendar-bound objective made up of one or more Habits
model Goal {
  id        String   @id @default(uuid())
  userId    String
  title     String   @db.VarChar(255)
  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  habits Habit[]

  @@index([userId])
}

// HabitGoalType - how a habit's progress is measured over its goal period
enum HabitGoalType {
  SUM
  THRESHOLD_COUNT
}

// Habit - belongs to exactly one Goal; defines how often and how much
model Habit {
  id     String @id @default(uuid())
  goalId String
  userId String

  name     String        @db.VarChar(255)
  unit     String?
  goalType HabitGoalType

  // SUM: total target over the goal period
  targetValue Float?

  // THRESHOLD_COUNT: a day counts if its task value >= dailyMinValue;
  // targetDays is how many qualifying days are needed
  dailyMinValue Float?
  targetDays    Int?

  // Specific days of week this habit is scheduled on: 0=Sun..6=Sat
  frequencyDays Int[]

  // Pre-fills new tasks' value; editable per task afterwards
  defaultTaskValue Float?

  currentStreak Int @default(0)
  longestStreak Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goal  Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([goalId])
  @@index([userId])
}

// TaskStatus - completion state of a single day's Task
enum TaskStatus {
  DONE
  NOT_DONE
}

// Task - one scheduled day's instance of a Habit, lazily created on first read
model Task {
  id      String @id @default(uuid())
  habitId String

  date        DateTime   @db.Date
  value       Float?
  status      TaskStatus @default(NOT_DONE)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([habitId, date])
}

// RefreshToken - for token revocation capability
model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}
